<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" style="-fx-background-color: #ffffff; -fx-border-color: #b2dfdb; -fx-border-radius: 10;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.pharmacy_system.Controller.OrderDialogController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text=" Создание заявки" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #004d40;"/>

    <Separator style="-fx-background-color: #b2dfdb;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="drugComboBox" promptText="Выберите препарат" prefWidth="300" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #b2dfdb;"/>
        <TextField fx:id="quantityField" promptText="Количество" prefWidth="100" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-padding: 8; -fx-border-radius: 20; -fx-border-color: #b2dfdb;"/>
        <Button fx:id="addItemButton" text="➕ Добавить" onAction="#addItem" style="-fx-background-color: #80cbc4; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 16;"/>
    </HBox>

    <TableView fx:id="itemsTable" VBox.vgrow="ALWAYS" prefHeight="200" style="-fx-background-color: #ffffff; -fx-border-color: #b2dfdb; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="drugNameColumn" text="Препарат" prefWidth="350"/>
            <TableColumn fx:id="quantityColumn" text="Количество" prefWidth="100" style="-fx-alignment: CENTER;"/>
        </columns>
    </TableView>

    <Separator style="-fx-background-color: #b2dfdb;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="removeItemButton" text="🗑 Удалить выбранное" onAction="#removeItem" style="-fx-background-color: #ef9a9a; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 16;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="saveButton" text="💾 Сохранить" onAction="#saveOrder" style="-fx-background-color: #80cbc4; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 16;"/>
        <Button fx:id="cancelButton" text="✖ Отмена" onAction="#close" style="-fx-background-color: #ef9a9a; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 16;"/>
    </HBox>
</VBox>