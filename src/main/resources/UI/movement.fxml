<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="10" style="-fx-background-color: #e0f2f1;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.pharmacy_system.Controller.MovementController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text=" Движения товаров" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004d40;"/>

    <Separator style="-fx-background-color: #b2dfdb;"/>

    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="🔍 Поиск по препарату..." HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-padding: 8; -fx-border-radius: 20; -fx-border-color: #b2dfdb;"/>
        <DatePicker fx:id="startDatePicker" promptText="Дата с" style="-fx-background-color: #ffffff; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #b2dfdb;"/>
        <DatePicker fx:id="endDatePicker" promptText="Дата по" style="-fx-background-color: #ffffff; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #b2dfdb;"/>
        <Button fx:id="filterButton" text="🔍 Применить" onAction="#filterByDate" style="-fx-background-color: #90caf9; -fx-text-fill: #004d40; -fx-background-radius: 15; -fx-cursor: hand; -fx-padding: 6 12;"/>
        <Button text="🔄 Обновить" onAction="#refreshMovements" style="-fx-background-color: #ce93d8; -fx-text-fill: #004d40; -fx-background-radius: 15; -fx-cursor: hand; -fx-padding: 6 12;"/>
    </HBox>

    <TableView fx:id="movementsTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-border-color: #b2dfdb; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="drugColumn" text="Препарат" prefWidth="250"/>
            <TableColumn fx:id="typeColumn" text="Тип" prefWidth="80"/>
            <TableColumn fx:id="quantityColumn" text="Количество" prefWidth="80"/>
            <TableColumn fx:id="userColumn" text="Пользователь" prefWidth="120"/>
            <TableColumn fx:id="dateColumn" text="Дата" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button fx:id="incomeButton" text="➕ Приход" onAction="#registerIncome" style="-fx-background-color: #80cbc4; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 16;"/>
        <Button fx:id="expenseButton" text="➖ Расход" onAction="#registerExpense" style="-fx-background-color: #ef9a9a; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 16;"/>
        <Button fx:id="receiveByOrderButton" text="Приход по заявке" onAction="#receiveByOrder" style="-fx-background-color: #ffcc80; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 16;"/>
    </HBox>
</VBox>
