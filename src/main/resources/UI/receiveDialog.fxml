<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" style="-fx-background-color: #ffffff; -fx-border-color: #b2dfdb; -fx-border-radius: 10;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.pharmacy_system.Controller.ReceiveDialogController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Поступление товара по заявке" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #004d40;"/>

    <HBox spacing="20">
        <Label text="Заявка №:" style="-fx-text-fill: #004d40;"/>
        <Label fx:id="orderIdLabel" text="" style="-fx-text-fill: #00695c; -fx-font-weight: bold;"/>
        <Label text="Статус:" style="-fx-text-fill: #004d40;"/>
        <Label fx:id="statusLabel" text="" style="-fx-text-fill: #00695c;"/>
    </HBox>

    <Separator style="-fx-background-color: #b2dfdb;"/>

    <TableView fx:id="itemsTable" VBox.vgrow="ALWAYS" prefHeight="300" style="-fx-background-color: #ffffff; -fx-border-color: #b2dfdb; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="drugColumn" text="Препарат" prefWidth="280"/>
            <TableColumn fx:id="orderedColumn" text="Заказано" prefWidth="80" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="receivedColumn" text="Поступило" prefWidth="80" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="remainingColumn" text="Осталось" prefWidth="80" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="comingColumn" text="Пришло" prefWidth="100" style="-fx-alignment: CENTER;"/>
        </columns>
    </TableView>

    <Separator style="-fx-background-color: #b2dfdb;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="receiveAllButton" text="✅ Принять всё" onAction="#receiveAll" style="-fx-background-color: #80cbc4; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 16;"/>
        <Button fx:id="saveButton" text="💾 Сохранить" onAction="#saveReceive" style="-fx-background-color: #90caf9; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 16;"/>
        <Button fx:id="cancelButton" text="✖ Отмена" onAction="#close" style="-fx-background-color: #ef9a9a; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 16;"/>
    </HBox>
</VBox>