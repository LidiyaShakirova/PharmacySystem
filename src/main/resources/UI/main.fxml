<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.pharmacy_system.Controller.MainController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Верхняя панель -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label text="Пользователь:" style="-fx-text-fill: #004d40;"/>
        <Label fx:id="usernameLabel" text="" style="-fx-text-fill: #00695c; -fx-font-weight: bold;"/>
        <Button fx:id="logoutButton" text="🚪 Выход" onAction="#logout" style="-fx-background-color: #ef9a9a; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 5 15;"/>
    </HBox>

    <Separator style="-fx-background-color: #b2dfdb;"/>

    <!-- Вкладки - увеличенные -->
    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <Tab fx:id="monitorTab" text="Мониторинг" closable="false"/>
        <Tab fx:id="orderTab" text="Заявки" closable="false"/>
        <Tab fx:id="movementTab" text="Движения" closable="false"/>
        <Tab fx:id="adminTab" text="Управление" closable="false"/>
    </TabPane>
</VBox>