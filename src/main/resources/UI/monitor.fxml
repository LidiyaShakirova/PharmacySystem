<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" style="-fx-background-color: #e0f2f1;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.pharmacy_system.Controller.MonitorController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="📊 Мониторинг запасов" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004d40;"/>

    <Separator style="-fx-background-color: #b2dfdb;"/>

    <!-- Поиск и фильтры -->
    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="🔍 Поиск по названию..." HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-padding: 8; -fx-border-radius: 20; -fx-border-color: #b2dfdb;"/>
        <ComboBox fx:id="categoryFilter" prefWidth="200" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #b2dfdb;"/>
        <Button text="🔄 Обновить" onAction="#refreshTable" style="-fx-background-color: #ce93d8; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 16;"/>
    </HBox>

    <!-- Таблица -->
    <TableView fx:id="drugsTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-border-color: #b2dfdb; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="nameColumn" text="Препарат" prefWidth="350"/>
            <TableColumn fx:id="categoryColumn" text="Категория" prefWidth="150"/>
            <TableColumn fx:id="stockColumn" text="Остаток" prefWidth="80" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="salesColumn" text="Отпуск/нед" prefWidth="100" style="-fx-alignment: CENTER;"/>
        </columns>
    </TableView>

    <Label fx:id="totalCountLabel" text="Найдено: 0" style="-fx-font-style: italic; -fx-text-fill: #00695c;"/>

    <Separator style="-fx-background-color: #b2dfdb;"/>

    <!-- ГРУППА 1: Управление препаратами (видна только администратору) -->
    <VBox fx:id="drugAdminGroup" spacing="5">
        <Label text="💊 Управление препаратами" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #004d40;"/>
        <HBox spacing="10">
            <Button text="➕ Добавить" onAction="#addDrug" style="-fx-background-color: #80cbc4; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 6 14; -fx-font-size: 12px;"/>
            <Button text="✏ Редактировать" onAction="#editDrug" style="-fx-background-color: #ffcc80; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 6 14; -fx-font-size: 12px;"/>
            <Button text="🗑 Удалить" onAction="#deleteDrug" style="-fx-background-color: #ef9a9a; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 6 14; -fx-font-size: 12px;"/>
        </HBox>
    </VBox>

    <!-- ГРУППА 2: Управление категориями (видна только администратору) -->
    <VBox fx:id="categoryAdminGroup" spacing="5">
        <Label text="📁 Управление категориями" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #004d40;"/>
        <HBox spacing="10">
            <Button text="➕ Добавить" onAction="#addCategory" style="-fx-background-color: #80cbc4; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 6 14; -fx-font-size: 12px;"/>
            <Button text="✏ Редактировать" onAction="#editCategory" style="-fx-background-color: #ffcc80; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 6 14; -fx-font-size: 12px;"/>
            <Button text="🗑 Удалить" onAction="#deleteCategory" style="-fx-background-color: #ef9a9a; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 6 14; -fx-font-size: 12px;"/>
        </HBox>
    </VBox>
</VBox>