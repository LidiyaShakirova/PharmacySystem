<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER" style="-fx-background-color: #ffffff; -fx-border-color: #b2dfdb; -fx-border-radius: 10;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.pharmacy_system.Controller.UserDialogController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Редактирование пользователя" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004d40;"/>

    <Separator style="-fx-background-color: #b2dfdb;"/>

    <Label text="Логин:" style="-fx-text-fill: #004d40;"/>
    <TextField fx:id="usernameField" prefWidth="350" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-padding: 8; -fx-border-radius: 20; -fx-border-color: #b2dfdb;"/>

    <Label text="Пароль:" style="-fx-text-fill: #004d40;"/>
    <PasswordField fx:id="passwordField" promptText="Оставьте пустым, если не меняете" prefWidth="350" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-padding: 8; -fx-border-radius: 20; -fx-border-color: #b2dfdb;"/>

    <Label text="Роль:" style="-fx-text-fill: #004d40;"/>
    <ComboBox fx:id="roleComboBox" prefWidth="350" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #b2dfdb;"/>

    <Separator style="-fx-background-color: #b2dfdb;"/>

    <HBox spacing="15" alignment="CENTER">
        <Button fx:id="saveButton" text="💾 Сохранить" onAction="#saveUser" prefWidth="120" style="-fx-background-color: #80cbc4; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 16;"/>
        <Button text="✖ Отмена" onAction="#close" prefWidth="120" style="-fx-background-color: #ef9a9a; -fx-text-fill: #004d40; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 16;"/>
    </HBox>
</VBox>